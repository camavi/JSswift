{
  "name": "@jsswift/knowledge-mcp",
  "version": "0.1.1",
  "description": "Read-only MCP for the installed JSswift version's documentation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node ../../tools/build-knowledge-mcp.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "license": "MIT",
  "bin": {
    "jsswift-mcp": "dist/server.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camavi/JSswift.git",
    "directory": "ai/mcp"
  },
  "publishConfig": {
    "access": "public"
  }
}
