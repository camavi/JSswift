{
  "name": "jsswift",
  "private": true,
  "version": "1.0.41",
  "description": "JSswift UI + reactive runtime framework",
  "author": "Carlos Malleux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camavi/JSswift.git"
  },
  "homepage": "https://github.com/camavi/JSswift#readme",
  "bugs": {
    "url": "https://github.com/camavi/JSswift/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:vite": "vite",
    "watch:ui:css": "node tools/watch-ui-css.mjs",
    "build": "vite build",
    "build:cms": "node tools/build-cms.mjs",
    "build:ui:assets": "node tools/build-ui-assets.mjs",
    "build:ui:css": "node tools/build-ui-css.mjs",
    "build:ui": "npm run build:ui:assets && npm run build:ui:css && node tools/build-ui.mjs",
    "build:jsswift": "node tools/build-jsswift.mjs",
    "build:runtime": "npm run build:cms && npm run build:ui && npm run build:jsswift",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "gen:ui-dts": "node cms-dev/generate-ui-dts.mjs",
    "gen:ui-dts:watch": "node cms-dev/generate-ui-dts.mjs --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "vite": "^8.3.0"
  }
}
