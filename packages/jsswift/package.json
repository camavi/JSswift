{
  "name": "jsswift",
  "version": "2.0.1",
  "description": "Umbrella package for JSswift core + UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camavi/JSswift.git",
    "directory": "packages/jsswift"
  },
  "homepage": "https://github.com/camavi/JSswift#readme",
  "bugs": {
    "url": "https://github.com/camavi/JSswift/issues"
  },
  "type": "module",
  "main": "./dist/jsswift.js",
  "module": "./dist/jsswift.js",
  "exports": {
    ".": "./dist/jsswift.js",
    "./min": "./dist/min-jsswift.js",
    "./jsswift.min.js": "./dist/jsswift.min.js",
    "./img/logo.svg": "./dist/img/logo.svg",
    "./img/svg/tabler-icons-sprite.svg": "./dist/img/svg/tabler-icons-sprite.svg",
    "./css/base.css": "./dist/css/base.css",
    "./css/ui.css": "./dist/css/ui.css",
    "./css/ui-light.css": "./dist/css/ui-light.css",
    "./css/ui-light.min.css": "./dist/css/ui-light.min.css",
    "./css/min-ui.css": "./dist/css/min-ui.css",
    "./css/ui.min.css": "./dist/css/ui.min.css",
    "./css/ui-components.css": "./dist/css/ui-components.css",
    "./css/responsive.css": "./dist/css/responsive.css",
    "./css/animation.css": "./dist/css/animation.css",
    "./css/docs.css": "./dist/css/docs.css",
    "./package.json": "./package.json",
    "./knowledge-map.json": "./dist/documentions/knowledge-map.json",
    "./tabler": "./dist/tabler.js",
    "./css/fonts-nunito.css": "./dist/css/fonts-nunito.css",
    "./css/fonts-material.css": "./dist/css/fonts-material.css",
    "./AI.md": "./dist/documentions/AI.md"
  },
  "files": [
    "dist",
    "AI.md"
  ],
  "jsswiftDocumentation": {
    "start": "AI.md",
    "map": "dist/documentions/knowledge-map.json",
    "additionalApis": "dist/documentions/components",
    "readingOrder": "Read AI.md alone in a separate operation. For CRUD use its compact example without pre-reading component contracts. Use the map only for missing APIs and read one focused section."
  }
}
